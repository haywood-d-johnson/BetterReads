# Base URL of the BetterReads API server.
#
# IMPORTANT: a physical phone running Expo Go CANNOT reach "localhost" — that
# points at the phone itself. Use your dev machine's LAN IP (e.g. the address
# shown by `ipconfig` on Windows), or an Android emulator's 10.0.2.2 alias.
#
# Examples:
#   EXPO_PUBLIC_API_URL=http://192.168.1.50:3001   # phone on same Wi-Fi
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:3001        # Android emulator
#   EXPO_PUBLIC_API_URL=http://localhost:3001       # web / iOS simulator
EXPO_PUBLIC_API_URL=http://localhost:3001
