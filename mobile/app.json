{
  "expo": {
    "name": "BetterReads",
    "slug": "betterreads",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "betterreads",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#dce4d0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.betterreads.app"
    },
    "android": {
      "package": "com.betterreads.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
